#!/usr/bin/env bash
#
# leaf — Limpeza simples do sistema (Arch/Manjaro)
#
# Limpa: uv, pip, ccache/sccache/go, pacman, yay, apt, dnf, caches de
# navegadores (Brave, Firefox, Chrome) e arquivos seguros de limpar
# (journal, temporários, relatórios de crash, lixeira, miniaturas, ~/.cache,
# flatpak).
#
# Ao final, exibe a SOMA de espaço total liberado.
#
# Uso:
#   ./leaf [-y]
#     -y, --yes   não pede confirmação para esvaziar a lixeira
#
# Personalização (variáveis de ambiente):
#   LEAF_ART       arte ASCII exibida no cabeçalho
#   LEAF_TITLE     título do cabeçalho
#   LEAF_SUBTITLE  subtítulo do cabeçalho
#
# Exemplo:
#   LEAF_TITLE="meu limpa" LEAF_SUBTITLE="feito por mim" ./leaf
#
set -u

# ===== Flags =====
ASSUM_YES=false
for arg in "$@"; do
    case "$arg" in
        -y|--yes) ASSUM_YES=true ;;
    esac
done

# ===== Cores (desligadas se não for terminal) =====
if [[ -t 1 ]]; then
    RED=$'\033[0;31m'
    GREEN=$'\033[0;32m'
    YELLOW=$'\033[1;33m'
    CYAN=$'\033[0;36m'
    BOLD=$'\033[1m'
    NC=$'\033[0m'
else
    RED='' GREEN='' YELLOW='' CYAN='' BOLD='' NC=''
fi

# ===== Cabeçalho (personalizável) =====

# Onda na cor da folha (adaptado de exemplo.sh) — abertura e celebração final.
# Mesma cor que pinta a folha do banner: verde (32) e verde em negrito (1;32).
# Uso: rainbow [ciclos] — cada ciclo = 2 frames (~0.1s). No-op fora de TTY.
rainbow() {
    local cycles="${1:-3}"
    [[ -t 1 ]] || return 0
    local cols
    cols=$(tput cols 2>/dev/null)
    [[ "$cols" =~ ^[0-9]+$ ]] && (( cols > 0 )) || cols=80
    local shades=("32" "1;32")   # a cor da folha, normal e em negrito
    local offset=0 i f frames
    frames=$(( cycles * 2 ))
    for ((f = 0; f < frames; f++)); do
        printf '\r'
        for ((i = 0; i < cols; i++)); do
            printf "\033[%sm█" "${shades[$(( (i + offset) % 2 ))]}"
        done
        offset=$(( (offset + 1) % 2 ))
        sleep 0.05
    done
    printf '\033[0m'  # deixa o último frame como cortina; finish_bar quebra a linha
}

# Arte padrão (folha) — personalize com LEAF_ART
DEFAULT_ART='⠀⠀⠀⠀⠀⠀⠀⠀⣀⣠⣤⣤⣄⣀⣀⡀⠀⠀⠀
⠀⠀⠀⠀⠀⢀⣶⣿⣿⣿⣿⣿⣿⣿⣿⣿⣷⣶⠶
⠀⠀⠀⠀⢠⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡿⠃⠀
⠀⠀⠀⢀⣿⣿⣿⣿⣿⣿⣿⣿⣿⡿⠋⠀⠀⠀
⢀⣠⠞⠋⠉⠛⠻⠿⣿⣿⣿⠿⠟⠋⠀⠀⠀⠀⠀
⠞⠁⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀⠀'

print_banner() {
    local art="${LEAF_ART-$DEFAULT_ART}"
    local title="${LEAF_TITLE:-leaf — limpeza do sistema}"
    local subtitle="${LEAF_SUBTITLE:-caches • pacotes • navegadores • temporários}"

    echo
    if [[ -n "$art" ]]; then
        while IFS= read -r line; do
            echo -e "${GREEN}${line}${NC}"
        done <<< "$art"
        echo
    fi
    echo -e "  ${BOLD}${CYAN}${title}${NC}"
    echo -e "  ${subtitle}"
    echo -e "  ${YELLOW}---------------------------------------------------${NC}"
    echo
}
print_banner
rainbow 5

# ===== Contador de espaço liberado =====
TOTAL_BYTES=0

add_freed() {
    local b="${1:-}"
    [[ "$b" =~ ^[0-9]+$ ]] && TOTAL_BYTES=$((TOTAL_BYTES + b))
}

# Converte bytes para formato legível
human_bytes() {
    local b="${1:-0}"
    if   (( b >= 1073741824 )); then awk "BEGIN{printf \"%.2f GiB\", $b/1073741824}"
    elif (( b >= 1048576 ));   then awk "BEGIN{printf \"%.2f MiB\", $b/1048576}"
    elif (( b >= 1024 ));      then awk "BEGIN{printf \"%.1f KiB\", $b/1024}"
    else printf '%s B' "$b"; fi
}

# ===== Utilitários =====
TOTAL_STEPS=15
CURRENT_STEP=0
BAR_WIDTH=20
BAR_ACTIVE=false

# Repete um caractere n vezes (usado na barra de progresso)
repeat() {
    local char="$1" n="$2" out=""
    while (( n-- > 0 )); do out+="$char"; done
    printf '%s' "$out"
}

# Inicia um novo passo: limpa a barra anterior (se ativa) e exibe o cabeçalho
section() {
    local name="$1"
    if [[ -t 1 ]] && $BAR_ACTIVE; then
        printf '\r\033[2K'
    else
        echo
    fi
    BAR_ACTIVE=false
    CURRENT_STEP=$((CURRENT_STEP + 1))
    echo -e "${YELLOW}==> [${CURRENT_STEP}/${TOTAL_STEPS}] ${name}${NC}"
}

# Atualiza a barra de progresso (mesma linha, sem empilhar)
update_bar() {
    local filled empty bar pct
    filled=$(( CURRENT_STEP * BAR_WIDTH / TOTAL_STEPS ))
    empty=$(( BAR_WIDTH - filled ))
    bar="$(repeat '█' "$filled")$(repeat '░' "$empty")"
    pct=$(( CURRENT_STEP * 100 / TOTAL_STEPS ))
    if [[ -t 1 ]]; then
        printf '\r\033[2K  %s%s%s  %s%s%%%s' "$CYAN" "$bar" "$NC" "$GREEN" "$pct" "$NC"
        BAR_ACTIVE=true
    fi
}

# Finaliza a barra (quebra a linha ao terminar o script)
finish_bar() {
    if [[ -t 1 ]] && $BAR_ACTIVE; then
        printf '\n'
    fi
}

# Mostra uma linha de progresso para operações demoradas
progress() {
    echo -e "  ${YELLOW}... $1...${NC}"
}

# Spinner animado (⠋⠙⠹...) enquanto um PID roda. No-op fora de TTY.
# Adaptado de exemplo5.sh
spin_until() {
    local pid="$1" msg="$2"
    [[ -t 1 ]] || return 0
    local chars='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r  \033[0;36m%s\033[0m %s' "${chars:i:1}" "$msg"
        i=$(( (i + 1) % ${#chars} ))
        sleep 0.1
    done
    printf '\r\033[2K'
}

# Executa um comando com spinner, exibindo a saída dele ao final.
# ATENÇÃO: somente comandos NÃO interativos (sem prompts, sem sudo).
run_spinner() {
    local msg="$1"; shift
    if [[ ! -t 1 ]]; then
        "$@"
        return $?
    fi
    local tmp pid out rc
    tmp=$(mktemp)
    { "$@" >"$tmp" 2>&1; printf '%s' "$?" > "${tmp}.rc"; } &
    pid=$!
    spin_until "$pid" "$msg"
    wait "$pid" 2>/dev/null
    out=$(cat "$tmp" 2>/dev/null)
    rc=$(cat "${tmp}.rc" 2>/dev/null)
    rm -f "$tmp" "${tmp}.rc"
    [[ "$rc" =~ ^[0-9]+$ ]] || rc=1
    [[ -n "$out" ]] && echo "$out"
    return "$rc"
}

# Remove um diretório (com spinner), reportando e somando o espaço liberado
remove_dir() {
    local dir="$1" name="$2"
    if [[ -d "$dir" ]]; then
        local bytes tmp pid
        tmp=$(mktemp)
        { du -sb "$dir" 2>/dev/null | cut -f1 > "$tmp"; rm -rf "${dir:?}"; } &
        pid=$!
        spin_until "$pid" "limpando ${name}"
        wait "$pid" 2>/dev/null
        bytes=$(cat "$tmp" 2>/dev/null)
        rm -f "$tmp"
        add_freed "${bytes:-0}"
        echo -e "  ${GREEN}✓${NC} ${name} ($(human_bytes "${bytes:-0}"))"
    else
        echo -e "  ${RED}✗${NC} ${name} (diretório não encontrado)"
    fi
}

# ===== uv =====
section "uv"
if command -v uv >/dev/null 2>&1; then
    if run_spinner "limpando cache do uv" uv cache clean; then
        echo -e "  ${GREEN}✓${NC} cache do uv limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do uv${NC}"
    fi
else
    echo -e "  ${YELLOW}- uv não instalado, pulando${NC}"
fi
update_bar

# ===== pip =====
section "pip"
pip_cmd=""
if command -v pip3 >/dev/null 2>&1; then
    pip_cmd="pip3"
elif command -v pip >/dev/null 2>&1; then
    pip_cmd="pip"
elif command -v python3 >/dev/null 2>&1; then
    pip_cmd="python3 -m pip"
fi
if [[ -n "$pip_cmd" ]]; then
    if run_spinner "limpando cache do pip" $pip_cmd cache purge; then
        echo -e "  ${GREEN}✓${NC} cache do pip limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do pip${NC}"
    fi
else
    echo -e "  ${YELLOW}- pip não instalado, pulando${NC}"
fi
update_bar

# ===== Caches de compilação =====
# Compiladores em cache: o custo de limpar é recompilar (CPU), não re-baixar.
section "caches de compilação"
cc_found=false
if command -v ccache >/dev/null 2>&1; then
    progress "limpando ccache"
    if ccache -C; then
        echo -e "  ${GREEN}✓${NC} ccache limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar ccache${NC}"
    fi
    cc_found=true
fi
if command -v sccache >/dev/null 2>&1; then
    progress "limpando sccache"
    if sccache --clear; then
        echo -e "  ${GREEN}✓${NC} sccache limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar sccache${NC}"
    fi
    cc_found=true
fi
if command -v go >/dev/null 2>&1; then
    gocache="$(go env GOCACHE 2>/dev/null)"
    if [[ -n "${gocache:-}" && -d "$gocache" ]]; then
        gobytes=$(du -sb "$gocache" 2>/dev/null | cut -f1)
        if run_spinner "limpando cache de build do go" go clean -cache; then
            add_freed "${gobytes:-0}"
            echo -e "  ${GREEN}✓${NC} go ($(human_bytes "${gobytes:-0}"))"
        else
            echo -e "  ${RED}✗ falha ao limpar cache do go${NC}"
        fi
    else
        echo -e "  ${YELLOW}- go sem cache de build, pulando${NC}"
    fi
    cc_found=true
fi
if ! $cc_found; then
    echo -e "  ${YELLOW}- ccache, sccache e go não instalados, pulando${NC}"
fi
update_bar

# ===== pacman =====
# Política de prompts: o usuário confirma apenas o PRIMEIRO prompt da seção
# (remoção de órfãos). Os demais passam automaticamente (--noconfirm).
section "pacman"
if command -v pacman >/dev/null 2>&1; then
    local_orphans=$(pacman -Qtdq 2>/dev/null)
    if [[ -n "$local_orphans" ]]; then
        progress "removendo pacotes órfãos (pode pedir a senha do sudo)"
        if sudo pacman -Rns $local_orphans; then
            echo -e "  ${GREEN}✓${NC} pacotes órfãos removidos"
        else
            echo -e "  ${RED}✗ falha ao remover pacotes órfãos${NC}"
        fi
    fi
    progress "esvaziando cache do pacman (pode demorar)"
    if sudo pacman -Sc --noconfirm; then
        echo -e "  ${GREEN}✓${NC} cache do pacman limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do pacman${NC}"
    fi
else
    echo -e "  ${YELLOW}- pacman não encontrado, pulando${NC}"
fi
update_bar

# ===== yay =====
# Mesma política do pacman: prompts passam automaticamente (--noconfirm).
section "yay"
if command -v yay >/dev/null 2>&1; then
    progress "limpando cache do yay"
    if yay -Sc --noconfirm; then
        echo -e "  ${GREEN}✓${NC} cache do yay limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do yay${NC}"
    fi
    echo "  (dica: rode 'yay -scc' para remover também órfãos AUR)"
else
    echo -e "  ${YELLOW}- yay não encontrado, pulando${NC}"
fi
update_bar

# ===== Outros gerenciadores de pacotes (apt/dnf/rpm) =====
# Detecta quais estão instalados e limpa o cache de cada um.
section "outros gerenciadores (apt/dnf/rpm)"

# apt (Debian/Ubuntu)
if command -v apt >/dev/null 2>&1; then
    progress "limpando cache do apt (apt-get clean)"
    if sudo apt-get clean; then
        echo -e "  ${GREEN}✓${NC} cache do apt limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do apt${NC}"
    fi
    echo "  (dica: 'sudo apt-get autoremove' remove também pacotes órfãos)"
else
    echo -e "  ${YELLOW}- apt não encontrado, pulando${NC}"
fi

# dnf (Fedora/RHEL)
if command -v dnf >/dev/null 2>&1; then
    progress "limpando cache do dnf (dnf clean all)"
    if sudo dnf clean all; then
        echo -e "  ${GREEN}✓${NC} cache do dnf limpo"
    else
        echo -e "  ${RED}✗ falha ao limpar cache do dnf${NC}"
    fi
else
    echo -e "  ${YELLOW}- dnf não encontrado, pulando${NC}"
fi

# rpm (ferramenta de baixo nível — não possui cache próprio)
if command -v rpm >/dev/null 2>&1; then
    echo -e "  ${YELLOW}- rpm presente (ferramenta de baixo nível); o cache de pacotes RPM é gerenciado pelo dnf/yum${NC}"
else
    echo -e "  ${YELLOW}- rpm não encontrado, pulando${NC}"
fi
update_bar

# ===== Navegadores =====
section "Navegadores"

# Brave
if [[ -d "$HOME/.config/BraveSoftware" ]]; then
    remove_dir "$HOME/.config/BraveSoftware/Brave-Browser/Default/Cache" "Brave: Cache"
    remove_dir "$HOME/.config/BraveSoftware/Brave-Browser/Default/Code Cache" "Brave: Code Cache"
    remove_dir "$HOME/.config/BraveSoftware/Brave-Browser/Default/Service Worker/CacheStorage" "Brave: CacheStorage"
else
    echo -e "  ${YELLOW}- Brave não instalado, pulando${NC}"
fi

# Firefox (todos os perfis)
if [[ -d "$HOME/.mozilla/firefox" ]]; then
    for profile in "$HOME"/.mozilla/firefox/*.default* "$HOME"/.mozilla/firefox/*.release; do
        [[ -d "$profile" ]] || continue
        remove_dir "$profile/cache2" "Firefox: cache2 (${profile##*/})"
        remove_dir "$profile/startupCache" "Firefox: startupCache"
        remove_dir "$profile/storage/default" "Firefox: storage/default"
    done
else
    echo -e "  ${YELLOW}- Firefox não instalado, pulando${NC}"
fi

# Chrome
if [[ -d "$HOME/.config/google-chrome" ]]; then
    for profile in "$HOME"/.config/google-chrome/*/; do
        [[ -d "$profile" ]] || continue
        remove_dir "${profile}Cache" "Chrome: Cache (${profile##*/})"
        remove_dir "${profile}Code Cache" "Chrome: Code Cache"
        remove_dir "${profile}Service Worker/CacheStorage" "Chrome: CacheStorage"
    done
else
    echo -e "  ${YELLOW}- Chrome não instalado, pulando${NC}"
fi
update_bar

# ===== Arquivos seguros de limpar (um passo por item) =====

# Journal do systemd (mantém últimos 7 dias)
section "journal do systemd"
if command -v journalctl >/dev/null 2>&1; then
    before=0
    for jdir in /var/log/journal /run/log/journal; do
        [[ -d "$jdir" ]] || continue
        b=$(du -sb "$jdir" 2>/dev/null | cut -f1)
        [[ "$b" =~ ^[0-9]+$ ]] && before=$((before + b))
    done
    progress "compactando journal (mantendo os últimos 7 dias)"
    sudo journalctl --vacuum-time=7d >/dev/null 2>&1
    after=0
    for jdir in /var/log/journal /run/log/journal; do
        [[ -d "$jdir" ]] || continue
        b=$(du -sb "$jdir" 2>/dev/null | cut -f1)
        [[ "$b" =~ ^[0-9]+$ ]] && after=$((after + b))
    done
    freed=$((before - after)); (( freed < 0 )) && freed=0
    add_freed "$freed"
    echo -e "  ${GREEN}✓${NC} journal do systemd (mantidos 7 dias, $(human_bytes "$freed"))"
else
    echo -e "  ${YELLOW}- journalctl não encontrado, pulando${NC}"
fi
update_bar

# Arquivos temporários (antigos de mais de 1 dia)
section "arquivos temporários"
for tdir in /tmp /var/tmp; do
    [[ -d "$tdir" ]] || continue
    progress "limpando arquivos antigos de $tdir (mais de 1 dia)"
    bytes=$(sudo find "$tdir" -mindepth 1 -mtime +1 -exec du -cb {} + 2>/dev/null | tail -1 | awk '{print $1}')
    [[ "$bytes" =~ ^[0-9]+$ ]] || bytes=0
    sudo find "$tdir" -mindepth 1 -mtime +1 -delete 2>/dev/null
    add_freed "$bytes"
    echo -e "  ${GREEN}✓${NC} $tdir (antigos de 1 dia, $(human_bytes "$bytes"))"
done
update_bar

# ===== Relatórios de crash =====
# Dumps/relatórios de crash são descartáveis: não há o que re-baixar depois.
section "relatórios de crash"
cr_found=false
# systemd (Arch/Manjaro/Fedora)
if command -v coredumpctl >/dev/null 2>&1 && [[ -d /var/lib/systemd/coredump ]]; then
    crbytes=$(sudo du -sb /var/lib/systemd/coredump 2>/dev/null | cut -f1)
    if sudo coredumpctl cleanup; then
        add_freed "${crbytes:-0}"
        echo -e "  ${GREEN}✓${NC} coredumps do systemd ($(human_bytes "${crbytes:-0}"))"
    else
        echo -e "  ${RED}✗ falha ao limpar coredumps${NC}"
    fi
    cr_found=true
fi
# Debian/Ubuntu (apport)
if [[ -d /var/crash ]] && [[ -n "$(ls -A /var/crash 2>/dev/null)" ]]; then
    crbytes=$(sudo du -sb /var/crash 2>/dev/null | cut -f1)
    if sudo rm -rf /var/crash/* 2>/dev/null; then
        add_freed "${crbytes:-0}"
        echo -e "  ${GREEN}✓${NC} relatórios do apport ($(human_bytes "${crbytes:-0}"))"
    else
        echo -e "  ${RED}✗ falha ao limpar /var/crash${NC}"
    fi
    cr_found=true
fi
# Fedora (abrt)
if command -v abrt >/dev/null 2>&1 && [[ -d /var/lib/abrt ]] && [[ -n "$(ls -A /var/lib/abrt 2>/dev/null)" ]]; then
    crbytes=$(sudo du -sb /var/lib/abrt 2>/dev/null | cut -f1)
    if abrt clean; then
        add_freed "${crbytes:-0}"
        echo -e "  ${GREEN}✓${NC} relatórios do abrt ($(human_bytes "${crbytes:-0}"))"
    else
        echo -e "  ${RED}✗ falha ao limpar abrt${NC}"
    fi
    cr_found=true
fi
if ! $cr_found; then
    echo -e "  ${YELLOW}- nenhum relatório de crash encontrado, pulando${NC}"
fi
update_bar

# Lixeira
section "lixeira"
trash="$HOME/.local/share/Trash"
if [[ -d "$trash" ]]; then
    confirm=false
    if [[ "$ASSUM_YES" == "true" ]]; then
        confirm=true
    else
        # Pergunta de novo se a resposta for inválida (adaptado de exemplo7.sh)
        while true; do
            read -r -p "  Esvaziar a lixeira? [S/n] " ans
            case "$ans" in
                [Nn]*) confirm=false; break ;;
                ""|[Ss]*) confirm=true; break ;;
            esac
            echo -e "  ${YELLOW}responda s (sim) ou n (não)${NC}"
        done
    fi
    if $confirm; then
        tmp=$(mktemp)
        { du -sb "$trash" 2>/dev/null | cut -f1 > "$tmp";
          rm -rf "${trash:?}/files"/* "${trash:?}/info"/* 2>/dev/null; } &
        pid=$!
        spin_until "$pid" "esvaziando lixeira"
        wait "$pid" 2>/dev/null
        bytes=$(cat "$tmp" 2>/dev/null)
        rm -f "$tmp"
        add_freed "${bytes:-0}"
        echo -e "  ${GREEN}✓${NC} lixeira esvaziada ($(human_bytes "${bytes:-0}"))"
    else
        echo -e "  ${YELLOW}- lixeira mantida (use -y para pular confirmação)${NC}"
    fi
else
    echo -e "  ${YELLOW}- lixeira vazia ou inexistente${NC}"
fi
update_bar

# Miniaturas (legacy e atual)
section "miniaturas"
remove_dir "$HOME/.thumbnails" "miniaturas (~/.thumbnails)"
remove_dir "$HOME/.cache/thumbnails" "miniaturas (~/.cache/thumbnails)"
update_bar

# Cache do usuário (apps regeneram o que precisarem)
section "cache do usuário (~/.cache)"
if [[ -d "$HOME/.cache" ]]; then
    tmp=$(mktemp)
    { du -sb "$HOME/.cache" 2>/dev/null | cut -f1 > "$tmp";
      rm -rf "${HOME:?}/.cache"/* 2>/dev/null;
      rm -rf "${HOME:?}/.cache"/.[!.]* 2>/dev/null; } &
    pid=$!
    spin_until "$pid" "limpando ~/.cache"
    wait "$pid" 2>/dev/null
    bytes=$(cat "$tmp" 2>/dev/null)
    rm -f "$tmp"
    add_freed "${bytes:-0}"
    echo -e "  ${GREEN}✓${NC} ~/.cache limpo ($(human_bytes "${bytes:-0}"))"
else
    echo -e "  ${YELLOW}- ~/.cache inexistente${NC}"
fi
update_bar

# Flatpak (runtimes não utilizados)
section "flatpak"
if command -v flatpak >/dev/null 2>&1; then
    if run_spinner "removendo runtimes flatpak não utilizados" flatpak uninstall --unused -y; then
        echo -e "  ${GREEN}✓${NC} runtimes flatpak não utilizados removidos"
    else
        echo -e "  ${YELLOW}- nada a remover no flatpak${NC}"
    fi
else
    echo -e "  ${YELLOW}- flatpak não instalado, pulando${NC}"
fi
update_bar

# ===== Resumo =====
section "Resumo"
# Destaque em caixa (adaptado de exemplo6.sh)
total_human="$(human_bytes "$TOTAL_BYTES")"
box_text="Espaço total liberado: ${total_human}"
box_line="$(repeat '─' $(( ${#box_text} + 4 )))"
echo -e "  ${CYAN}╭${box_line}╮${NC}"
echo -e "  ${CYAN}│${NC}  Espaço total liberado: ${BOLD}${GREEN}${total_human}${NC}  ${CYAN}│${NC}"
echo -e "  ${CYAN}╰${box_line}╯${NC}"
echo
echo "  Dicas:"
echo "  - Feche os navegadores antes de rodar o script para garantir"
echo "    que nenhum arquivo de cache esteja em uso."
echo "  - Use -y para não pedir confirmação ao esvaziar a lixeira."
echo "  - Caches e miniaturas são regenerados automaticamente pelos apps."
echo "  - O total acima soma apenas o que foi medido (diretórios/temporários);"
echo "    limpezas de pacotes (uv/pip/pacman/yay/flatpak) não entram na soma."
echo
echo -e "${GREEN}${BOLD}  Limpeza concluída!${NC}"
update_bar
rainbow 7
finish_bar
